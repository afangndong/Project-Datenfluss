# Compose-Variablen (Kopie nach .env). Alle optional – Defaults stehen in docker-compose.yml.
APP_IMAGE=mini-kos
GIT_SHA=local
POSTGRES_USER=minikos
POSTGRES_PASSWORD=minikos
POSTGRES_DB=minikos
# Host-Ports (bei Konflikten ändern)
PROXY_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
KIBANA_PORT=5601
UNLEASH_PORT=4242
# Optional: Slack für Alert-Weiterleitung
SLACK_WEBHOOK_URL=
