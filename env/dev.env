APP_ENV=dev
LOG_JSON=true
LOG_LEVEL=DEBUG
API_KEY=
# Feature-Flag-Fallbacks (wenn Unleash aus ist)
FEATURE_NEUES_DASHBOARD=true
FEATURE_WARTUNGSHINWEIS=false
# Unleash aktivieren: Profil "flags" starten und die zwei Zeilen einkommentieren
# UNLEASH_URL=http://unleash:4242
# UNLEASH_TOKEN=default:development.unleash-insecure-client-token
